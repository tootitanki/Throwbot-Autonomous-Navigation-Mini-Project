<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="throwbot">
  <xacro:property name="wr" value="0.08"/>
  <xacro:property name="sep" value="0.34"/>

  <link name="base_footprint"/>
  <joint name="footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wr}"/>
  </joint>

  <link name="base_link">
    <inertial><mass value="8"/><inertia ixx="0.12" iyy="0.2" izz="0.25" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.40 0.30 0.12"/></geometry><material name="b"><color rgba="0.1 0.4 0.8 1"/></material></visual>
    <collision><geometry><box size="0.40 0.30 0.12"/></geometry></collision>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <inertial><mass value="0.6"/><inertia ixx="0.002" iyy="0.002" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wr}" length="0.04"/></geometry><material name="k"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wr}" length="0.04"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left" y="${sep/2}"/>
  <xacro:wheel name="right" y="${-sep/2}"/>

  <link name="caster">
    <inertial><mass value="0.2"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <visual><geometry><sphere radius="0.04"/></geometry></visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/><origin xyz="-0.16 0 -0.04"/>
  </joint>
  <gazebo reference="caster">
    <collision><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
  </gazebo>

  <!-- Sensor under test. Chosen with xacro args (see sensor_cfg.py / config/sensors.yaml). -->
  <xacro:arg name="sensor_kind" default="scan"/>
  <xacro:arg name="rate" default="10"/>
  <xacro:arg name="noise" default="0.01"/>
  <xacro:arg name="rmin" default="0.12"/>
  <xacro:arg name="rmax" default="8.0"/>
  <xacro:arg name="mx" default="0.05"/>
  <xacro:arg name="mz" default="0.09"/>
  <xacro:arg name="samples" default="360"/>
  <xacro:arg name="amin" default="-3.14159"/>
  <xacro:arg name="amax" default="3.14159"/>
  <xacro:arg name="width" default="320"/>
  <xacro:arg name="height" default="240"/>
  <xacro:arg name="hfov" default="1.5184"/>
  <xacro:property name="kind" value="$(arg sensor_kind)"/>

  <link name="sensor_link">
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.02" length="0.03"/></geometry></visual>
  </link>
  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/><child link="sensor_link"/><origin xyz="$(arg mx) 0 $(arg mz)"/>
  </joint>

  <xacro:if value="${kind in ('scan', 'range')}">
  <gazebo reference="sensor_link">
    <sensor name="range_sensor" type="gpu_lidar">
      <topic>sensor/scan</topic>
      <ignition_frame_id>sensor_link</ignition_frame_id>
      <update_rate>$(arg rate)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal><samples>$(arg samples)</samples><resolution>1</resolution><min_angle>$(arg amin)</min_angle><max_angle>$(arg amax)</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>$(arg rmin)</min><max>$(arg rmax)</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>$(arg noise)</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:if>

  <xacro:if value="${kind == 'depth'}">
  <gazebo reference="sensor_link">
    <sensor name="depth_sensor" type="depth_camera">
      <topic>sensor/depth</topic>
      <ignition_frame_id>sensor_link</ignition_frame_id>
      <update_rate>$(arg rate)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>$(arg hfov)</horizontal_fov>
        <image><width>$(arg width)</width><height>$(arg height)</height></image>
        <clip><near>$(arg rmin)</near><far>$(arg rmax)</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>$(arg noise)</stddev></noise>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${sep}</wheel_separation>
      <wheel_radius>${wr}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <!-- wheel odometry is NOT used (it drifts when the robot is blocked); it is published to unbridged topics -->
      <odom_topic>wheel_odom_unused</odom_topic>
      <frame_id>wheel_odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>wheel_tf_unused</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Odometry from the simulated model's actual world pose (independent of wheel slip): the localisation Nav2 sees -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>
</robot>
